{
  "manifest_version": 3,
  "name": "HushInMosiac Labeler",
  "description": "Smart on-device email organization and pattern recognition.",
  "version": "1.0.0",

  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "offscreen"
  ],

  "host_permissions": [
    "*://mail.google.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "*://mail.google.com/*"
      ],
      "js": ["content_script.js"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "web_accessible_resources": [
    {
      "resources": [
        "visualization.html",
        "visualization.css",
        "visualization.js",
        "Chart.min.js",
        "d3.min.js",
        "idb_store.js"
      ],
      "matches": [
        "*://mail.google.com/*"
      ]
    }
  ]
}
